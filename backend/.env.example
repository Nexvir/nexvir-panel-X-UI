# Nexvir Panel — Environment Variables
# Copy this to .env and edit before running

PORT=3000
NODE_ENV=production

# IMPORTANT: Change this to a long random string!
JWT_SECRET=change_this_to_a_secure_random_string_in_production

# Path to SQLite database
DB_PATH=./data/nexvir.db

# Domain (shown in generated configs and sub links)
DOMAIN=your.domain.com

# Frontend URL for CORS (use * to allow all, or set your exact domain)
FRONTEND_URL=*
